#!/usr/bin/env bash
# Start PDF Analyzer locally.
#
#   ./start                 backend (:8000) + frontend dev server with hot reload (:5173)
#   ./start --prod          build the UI once and run a single server (:8000)
#   ./start --api-port N --ui-port N
#
# Installs Nix if it is missing (asks for sudo). Ctrl+C stops everything.
set -euo pipefail
cd "$(dirname "$0")"

MODE=dev
API_PORT=8000
UI_PORT=5173
while [ $# -gt 0 ]; do
  case "$1" in
    --prod) MODE=prod ;;
    --api-port) API_PORT="$2"; shift ;;
    --ui-port) UI_PORT="$2"; shift ;;
    -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $1 (see ./start --help)" >&2; exit 1 ;;
  esac
  shift
done

say() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }

# ---- Nix --------------------------------------------------------------------------------
if ! command -v nix-shell >/dev/null 2>&1; then
  # Already installed but not on PATH in this shell?
  for f in /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh "$HOME/.nix-profile/etc/profile.d/nix.sh"; do
    # shellcheck disable=SC1090
    [ -e "$f" ] && . "$f"
  done
fi
if ! command -v nix-shell >/dev/null 2>&1; then
  say "Installing Nix (official installer, multi-user; asks for sudo)"
  sh <(curl --proto '=https' --tlsv1.2 -fsSL https://nixos.org/nix/install) --daemon --yes
  # shellcheck disable=SC1091
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

# ---- AI logins (warn only; the app also shows this in its AI picker) --------------------------
command -v claude >/dev/null 2>&1 && ! claude auth status 2>/dev/null | grep -q '"loggedIn": true' &&
  warn "Claude Code isn't logged in: run 'claude auth login' to use Claude."
command -v codex >/dev/null 2>&1 && ! codex login status >/dev/null 2>&1 &&
  warn "Codex isn't logged in: run 'codex login' to use OpenAI."
command -v claude >/dev/null 2>&1 || command -v codex >/dev/null 2>&1 ||
  warn "Neither Claude Code nor Codex is installed; questions can't be answered until one is."

# ---- Servers ----------------------------------------------------------------------------------
PIDS=()
cleanup() {
  trap - EXIT INT TERM
  say "Stopping"
  for pid in "${PIDS[@]}"; do kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true; done
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

wait_for() {  # wait_for <port> <name>
  for _ in $(seq 1 180); do
    curl -s -o /dev/null "http://127.0.0.1:$1/" && return 0
    sleep 1
  done
  warn "$2 didn't come up on port $1"; exit 1
}

for port in "$API_PORT" $([ "$MODE" = dev ] && echo "$UI_PORT"); do
  if curl -s -o /dev/null "http://127.0.0.1:$port/"; then
    warn "Something is already running on port $port (an earlier server?). Stop it, or pick another port with --api-port / --ui-port."
    trap - EXIT; exit 1
  fi
done

say "Preparing the environment (first run downloads packages; this can take a few minutes)"
nix-shell --run "test -d frontend/node_modules || (cd frontend && npm install)"

if [ "$MODE" = prod ]; then
  say "Building the UI and starting the server on :$API_PORT"
  setsid nix-shell --run "python3 backend/serve.py --port $API_PORT --build" &
  PIDS+=($!)
  wait_for "$API_PORT" "Server"
  URL_PORT=$API_PORT
else
  say "Starting the backend on :$API_PORT"
  setsid nix-shell --run "python3 backend/serve.py --port $API_PORT --reload" &
  PIDS+=($!)
  wait_for "$API_PORT" "Backend"
  say "Starting the frontend dev server on :$UI_PORT"
  setsid nix-shell --run "cd frontend && API_PORT=$API_PORT npm run dev -- --port $UI_PORT --strictPort" &
  PIDS+=($!)
  wait_for "$UI_PORT" "Frontend"
  URL_PORT=$UI_PORT
fi

echo
say "Open http://127.0.0.1:$URL_PORT"
echo "    Press Ctrl+C to stop."
wait
